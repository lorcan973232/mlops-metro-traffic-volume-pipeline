# Ignore local caches, virtual environments, and regenerated evidence while
# keeping the fixed raw dataset and trained model that the Docker/Kind demo needs.
# The exceptions below are part of the artefact contract, not accidental tracked
# binaries.
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.hypothesis/
.venv/
venv/
*.pyc
*.log
*.pid
*.tmp

reports/final_readiness/generated/

data/raw/*.csv
data/raw/*.xlsx
!data/raw/Metro_Interstate_Traffic_Volume.csv.gz
data/processed/*.csv
models/*.joblib
!models/traffic_volume_classifier.joblib

.env
.DS_Store
